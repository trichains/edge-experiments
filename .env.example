# Postgres connection string. Leave empty to run in sandbox mode (in-memory PGlite, seeded, resets on restart).
# With a value set, run `npm run db:migrate` once before starting the app.
DATABASE_URL=

# Public URL of the deployment, used for metadata. Recommended in production.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL. Example: https://edge-experiments.vercel.app
NEXT_PUBLIC_APP_URL=

# Dashboard mutations (flag changes, experiment status, simulate traffic).
# - Set: mutations require `Authorization: Bearer <ADMIN_TOKEN>`; the dashboard shows a field to enter it.
# - Empty + sandbox mode (no DATABASE_URL): mutations are open to anyone using the demo.
# - Empty + DATABASE_URL set: mutations are refused (fail closed). Set a token to enable them.
ADMIN_TOKEN=
