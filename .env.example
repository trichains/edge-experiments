# Postgres connection string. Leave empty to run in sandbox mode (in-memory PGlite, seeded, resets on restart).
# With a value set, run `npm run db:migrate` once before starting the app.
DATABASE_URL=

# Public URL of the deployment (used for metadata). Example: https://edge-experiments.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional. When set, dashboard mutations (flag changes, experiment status, simulate traffic) require
# `Authorization: Bearer <ADMIN_TOKEN>`. The dashboard shows a field to enter it.
ADMIN_TOKEN=
